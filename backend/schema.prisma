generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum FileType {
  REPORT
}

enum FileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SurveyFieldType {
  TEXT
  TEXTAREA
  SELECT
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  bcryptPassword String
  role           UserRole @default(STUDENT)
  createdAt      DateTime @default(now())

  // Контекст для админа: над какой когортой он работает сейчас
  activeCohortId String?
  activeCohort   Cohort? @relation("ActiveCohort", fields: [activeCohortId], references: [id])

  applications Application[]
}

model Cohort {
  id               String   @id @default(cuid())
  name             String   @unique
  applicationStart DateTime
  applicationEnd   DateTime
  practiceStart    DateTime
  practiceEnd      DateTime

  createdAt DateTime @default(now())

  cohortRoles       CohortRole[]
  applications      Application[]
  surveyFields      SurveyField[]
  testTasks         TestTask[]
  adminContext      User[]             @relation("ActiveCohort")
  documentTemplates DocumentTemplate[]
}

model CohortRole {
  id       String @id @default(cuid())
  cohortId String
  name     String

  cohort       Cohort        @relation(fields: [cohortId], references: [id])
  applications Application[]
  testTasks    TestTask[]

  @@unique([cohortId, name])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  cohortId      String
  roleId        String?
  status        ApplicationStatus @default(PENDING)
  reviewComment String?
  createdAt     DateTime          @default(now())

  user   User        @relation(fields: [userId], references: [id])
  cohort Cohort      @relation(fields: [cohortId], references: [id])
  role   CohortRole? @relation(fields: [roleId], references: [id])

  answers   ApplicationAnswer[]
  docData   DocumentData?
  taskCards TaskCard[]
  files     ApplicationFile[]

  @@unique([userId, cohortId])
}

model SurveyField {
  id       String @id @default(cuid())
  cohortId String

  label   String
  type    SurveyFieldType
  options Json?
  order   Int

  cohort             Cohort              @relation(fields: [cohortId], references: [id])
  applicationAnswers ApplicationAnswer[]
}

model ApplicationAnswer {
  id            String @id @default(cuid())
  applicationId String
  fieldId       String
  value         String

  application Application @relation(fields: [applicationId], references: [id])
  field       SurveyField @relation(fields: [fieldId], references: [id])

  @@unique([applicationId, fieldId])
}

model DocumentData {
  id            String @id @default(cuid())
  applicationId String @unique

  data Json @default("{}")

  application Application @relation(fields: [applicationId], references: [id])
}

model DocumentTemplate {
  id       String @id @default(cuid())
  cohortId String

  name String
  slug String // unique name for access ex: /cohort/id/documents/slug

  uri String

  requirements Json @default("{}")

  cohort Cohort @relation(fields: [cohortId], references: [id])

  @@unique([cohortId, slug])
}

model ApplicationFile {
  id            String @id @default(cuid())
  applicationId String

  type       FileType
  storageUri String
  status     FileStatus @default(PENDING)
  comment    String?

  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, type])
}

model TaskCard {
  id            String @id @default(cuid())
  applicationId String

  date         DateTime
  title        String
  description  String
  artifactLink String?
  updatedAt    DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, date])
}

model TestTask {
  id       String @id @default(cuid())
  cohortId String
  roleId   String

  content     String
  publishedAt DateTime?

  cohort Cohort     @relation(fields: [cohortId], references: [id])
  role   CohortRole @relation(fields: [roleId], references: [id])
}
